
@page
@model AuraCafé.Web.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Product Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Product Management</h2>
            <p class="text-muted mb-0">Manage your café menu and prices.</p>
        </div>
        <a asp-page="./Create" class="btn btn-primary">
            + Add Product
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <h5 class="fw-semibold">All Products</h5>
                    <span class="badge bg-primary">
                        @Model.Products.Count products
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @product.Name
                                        </div>
                                        <small class="text-muted">
                                            @product.Description
                                        </small>
                                    </td>
                                    <td>@product.CategoryName</td>
                                    <td class="fw-semibold">
                                        @((product.PriceCents / 100m).ToString("C",
                                            System.Globalization.CultureInfo.GetCultureInfo("en-US")))
                                    </td>
                                    <td>
                                        @if (product.IsAvailable)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unavailable</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="./Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@product.Id"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this product?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Products.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        No products found. Add your first product.
                    </div>
                }
            </div>
        </div>
    }
</div>

@page
@model AuraCafé.Web.Pages.IndexModel

@{
    ViewData["Title"] = "CafeFlow Dashboard";
}

<div class="container py-5">

    <h1 class="mb-4">☕ CafeFlow Dashboard</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Cafe != null)
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <h3>@Model.Cafe.Name</h3>

                <p>
                    <strong>Address:</strong>
                    @Model.Cafe.Address
                </p>

                <p>
                    <strong>Base Currency:</strong>
                    @Model.Cafe.BaseCurrency
                </p>

                <p>
                    <strong>Supported Currencies:</strong>
                    @string.Join(", ",
                        Model.Cafe.SupportedCurrencies)
                </p>

                <span class="badge bg-success">
                    @Model.Cafe.Status
                </span>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No café information available.
        </div>
    }

</div>
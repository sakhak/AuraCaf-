@page
@model AuraCafé.Web.Pages.Account.LoginModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Staff Login";
}
<div class="login-shell">
    <section class="login-story" aria-labelledby="storyHeading">
        <span class="story-label"><span aria-hidden="true">&#10022;</span> YOUR DAILY DOSE OF HAPPY</span>
        <h1 id="storyHeading">Good coffee.<br /> Lovely people.<br /> <span>That's our Aura.</span></h1>
        <p>A cozy corner for the team behind every favorite cup.</p>
        <div class="coffee-art" aria-hidden="true">
            <span class="art-spark spark-one">&#10022;</span><span class="art-spark spark-two">&#9825;</span>
            <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <ellipse cx="200" cy="261" rx="135" ry="16" fill="#e7b8cb" opacity=".5" />
                <path d="M164 68c-22-23 24-30 5-53M201 60c-22-23 24-30 5-53M237 68c-22-23 24-30 5-53" fill="none" stroke="#ba788e" stroke-width="6" stroke-linecap="round" />
                <ellipse cx="198" cy="246" rx="123" ry="15" fill="#fff9f1" stroke="#b5758d" stroke-width="4" />
                <path d="M286 119h21c64 0 58 84 0 84h-23" fill="#fff8f0" stroke="#8d4c67" stroke-width="7" />
                <path d="M292 139h12c34 0 32 43 0 43h-12" fill="#f7ccdc" stroke="#8d4c67" stroke-width="5" />
                <path d="M103 112h193l-13 91c-7 53-156 53-167 0z" fill="#fff8f0" stroke="#8d4c67" stroke-width="5" />
                <ellipse cx="199" cy="112" rx="96" ry="24" fill="#efc4a3" stroke="#8d4c67" stroke-width="5" />
                <ellipse cx="199" cy="114" rx="78" ry="15" fill="#98674d" />
                <path d="M185 113c-13-13 3-23 14-10 12-13 28-3 15 10l-15 12z" fill="#fff1db" />
                <path d="M159 173q7-9 14 0M224 173q7-9 14 0" fill="none" stroke="#734255" stroke-width="4" stroke-linecap="round" />
                <path d="M188 188q11 12 22 0" fill="none" stroke="#734255" stroke-width="4" stroke-linecap="round" />
                <ellipse cx="155" cy="186" rx="11" ry="6" fill="#efb0c2" /><ellipse cx="242" cy="186" rx="11" ry="6" fill="#efb0c2" />
            </svg>
            <span class="art-caption">brewed with a little love</span>
        </div>
        <div class="story-footer"><span aria-hidden="true">&#9825;</span> Small moments. Beautiful days.</div>
    </section>
    <section class="login-panel" aria-labelledby="loginHeading">
        <div class="login-form-wrap">
            <span class="login-wave" aria-hidden="true">&#10047;</span>
            <p class="login-eyebrow">THE AURA TEAM</p>
            <h2 id="loginHeading">Hello, lovely.</h2>
            <p class="login-intro">Sign in and make someone's day a little sweeter.</p>
            <form method="post" id="loginForm">
                <div asp-validation-summary="ModelOnly" class="login-errors" role="alert"></div>
                <div class="login-field">
                    <label asp-for="Input.Email">Email address</label>
                    <input asp-for="Input.Email" type="email" class="form-control" autocomplete="username" inputmode="email" spellcheck="false" autocapitalize="none" placeholder="you@example.com" required aria-describedby="emailError" />
                    <span asp-validation-for="Input.Email" id="emailError" class="field-error"></span>
                </div>
                <div class="login-field">
                    <label asp-for="Input.Password">Password</label>
                    <div class="password-wrap">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" required aria-describedby="passwordError" />
                        <button type="button" id="togglePassword" class="password-toggle" aria-controls="Input_Password" aria-pressed="false" hidden>Show</button>
                    </div>
                    <span asp-validation-for="Input.Password" id="passwordError" class="field-error"></span>
                </div>
                <button type="submit" class="login-submit">Sign In <span aria-hidden="true">&#8594;</span></button>
            </form>
            <p class="login-help">Need a hand signing in?<br />Ask your caf&#233; administrator.</p>
            <div class="login-note"><span aria-hidden="true">&#9825;</span> Your next lovely shift starts here.</div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}

@page
@model AuraCafé.Web.Areas.Admin.Pages.Payments.IndexModel

@{
    ViewData["Title"] = "Payment Management";

    var cafeZone = TimeZoneInfo.FindSystemTimeZoneById(
        "Asia/Phnom_Penh");

    string DisplayTime(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc),
            cafeZone).ToString("dd MMM yyyy, hh:mm tt");
}

<div class="mb-4">
    <h2 class="fw-bold">Payment Management</h2>
    <p class="portal-muted">
        View completed café payments.
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="portal-card">
                <p class="portal-muted">Recent Payments</p>
                <h3>@Model.PaymentCount</h3>
            </div>
        </div>

        <div class="col-md-6">
            <div class="portal-card">
                <p class="portal-muted">Recent Sales Collected</p>
                <h3>
                    $@((Model.TotalCollectedCents / 100m).ToString("0.00"))
                </h3>
            </div>
        </div>
    </div>

    <div class="portal-card">
        <h4 class="mb-3">Payment History</h4>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Payment</th>
                        <th>Order</th>
                        <th>Cashier</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Cash Received</th>
                        <th>Change</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td>#@payment.Id</td>
                            <td>@payment.OrderNumber</td>
                            <td>@payment.CashierName</td>
                            <td>@payment.Method</td>
                            <td>
                                $@((payment.AmountCents / 100m).ToString("0.00"))
                            </td>
                            <td>
                                $@((payment.CashReceivedCents / 100m).ToString("0.00"))
                            </td>
                            <td>
                                $@((payment.ChangeCents / 100m).ToString("0.00"))
                            </td>
                            <td>
                                @DisplayTime(payment.PaidAtUtc)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Payments.Count == 0)
        {
            <p class="text-muted">
                No payments recorded yet.
            </p>
        }

        <p class="text-muted small mt-3">
            Showing up to 200 recent payments.
            Totals reflect only these records.
        </p>
    </div>
}

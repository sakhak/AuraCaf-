@page
@model AuraCafé.Web.Areas.Admin.Pages.Staff.CreateModel
@{ ViewData["Title"] = "Add Employee"; }
<link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
<div class="staff-workspace"><header class="staff-heading"><div><p class="staff-eyebrow">WELCOME A NEW TEAM MEMBER</p><h1>Add Employee</h1><p class="text-muted mb-0">Create a staff profile and, for cashiers, a secure login.</p></div><a asp-page="./Index" class="btn btn-outline-primary">Back to staff</a></header>
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
<div class="staff-form-layout"><form method="post" class="staff-form" data-staff-save>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <h2>Personal details</h2><p class="small text-muted">Use the employee's current contact information.</p>
    <div class="mb-3"><label asp-for="Staff.FullName" class="form-label">Full name</label><input asp-for="Staff.FullName" class="form-control" autocomplete="name" maxlength="150" required /><span asp-validation-for="Staff.FullName" class="text-danger"></span></div>
    <div class="staff-field-grid"><div class="mb-3"><label asp-for="Staff.Email" class="form-label">Email address</label><input asp-for="Staff.Email" class="form-control" type="email" autocomplete="email" required /><span asp-validation-for="Staff.Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Staff.PhoneNumber" class="form-label">Phone number <span class="text-muted small">(optional)</span></label><input asp-for="Staff.PhoneNumber" class="form-control" type="tel" autocomplete="tel" maxlength="30" /><span asp-validation-for="Staff.PhoneNumber" class="text-danger"></span></div></div>
    <div class="staff-form-divider"></div><h2>Employment &amp; account</h2>
    <div class="staff-field-grid"><div class="mb-3"><label asp-for="Staff.Position" class="form-label">Position</label><select asp-for="Staff.Position" class="form-select" data-staff-position><option value="Cashier">Cashier</option><option value="Barista">Barista</option></select></div><div class="mb-3"><label asp-for="Staff.HireDate" class="form-label">Hire date</label><input asp-for="Staff.HireDate" type="date" class="form-control" required /><span asp-validation-for="Staff.HireDate" class="text-danger"></span></div></div>
    <div class="staff-password-section" data-staff-password><label asp-for="Staff.Password" class="form-label">Initial cashier password</label><input asp-for="Staff.Password" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="Staff.Password" class="text-danger"></span><p class="form-text">At least 12 characters, including uppercase, lowercase, a number and a symbol. A Barista profile does not create a login account.</p></div>
    <div class="staff-form-actions"><button type="submit" class="btn btn-primary">Save Employee</button><a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a></div>
</form><aside class="staff-side-panel"><span class="staff-side-icon" aria-hidden="true">&#9671;</span><p class="staff-eyebrow">ACCESS WITH PURPOSE</p><h2>A profile for their work</h2><dl><dt>Cashier</dt><dd>Creates an Identity login for POS, orders, payments and shifts under existing permissions.</dd><dt>Barista</dt><dd>Creates an employee profile without a login account.</dd></dl><div class="staff-note"><strong>Keep access intentional</strong><p class="small mb-0">This form does not grant Admin privileges. Account-type changes use a separate authorized workflow.</p></div></aside></div></div>
@section Scripts { <script src="~/js/staff.js" asp-append-version="true"></script> }

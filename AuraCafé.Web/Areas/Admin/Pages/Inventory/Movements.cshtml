@page "{ingredientId:int?}"
@model AuraCafé.Web.Areas.Admin.Pages.Inventory.MovementsModel
@using AuraCafé.Web.Models
@{ ViewData["Title"] = "Stock Movements"; }
<div class="inventory-workspace">
<header class="inventory-heading"><div><p class="inventory-eyebrow">STOCK ACTIVITY</p><h1>Stock Movement Ledger</h1><p class="text-muted mb-0">Receive, use and adjust stock with a clear record of every change.</p></div><a asp-page="./Index" class="btn btn-outline-primary">Back to ingredients</a></header><partial name="_InventoryNav" />
@if (Model.SuccessMessage is not null) { <div class="alert alert-success" role="status">@Model.SuccessMessage</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
@if (Model.Ingredient is { } ingredient)
{
    <section class="portal-card inventory-movement-editor mb-4"><h2 class="h4">@ingredient.Name</h2><p class="inventory-balance">Available: <strong>@ingredient.QuantityOnHand @ingredient.Unit</strong> / @ingredient.StockStatus</p>
        @if (ingredient.IsActive)
        {
            <form method="post" asp-route-IngredientId="@ingredient.Id" data-inventory-submit data-inventory-confirm="Record this stock movement? It becomes immutable. Corrections require another movement.">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Input.RequestId" type="hidden" />
                <div class="row g-3"><div class="col-md-4"><label asp-for="Input.Type" class="form-label">Movement type</label><select asp-for="Input.Type" class="form-select"><option value="StockIn">Stock in (receive supplies)</option><option value="StockOut">Stock out (usage / wastage)</option><option value="Adjustment">Adjustment (signed change)</option></select></div>
                <div class="col-md-4"><label asp-for="Input.Quantity" class="form-label">Quantity (@ingredient.Unit)</label><input asp-for="Input.Quantity" type="number" step="1" class="form-control" required /><span asp-validation-for="Input.Quantity" class="text-danger"></span></div></div>
                <p class="form-text">Stock-in/out: positive whole numbers only. Adjustment: enter the signed difference, not the counted balance. Example: recorded 1700, counted 1600 means -100. Zero is not a movement.</p>
                <div class="mb-3"><label asp-for="Input.Reason" class="form-label">Reason (required)</label><textarea asp-for="Input.Reason" class="form-control" minlength="3" maxlength="500" required></textarea><span asp-validation-for="Input.Reason" class="text-danger"></span></div>
                <details class="inventory-reference"><summary>Transaction reference and retry guidance</summary><p class="small text-muted mt-2">Transaction request: <code>@Model.Input.RequestId</code>. If a response is lost, check the ledger and retry this unchanged form with the same request ID.</p></details>
                <button type="submit" class="btn btn-primary">Record Movement</button>
            </form>
        }
        else { <p class="text-muted">Ingredient is inactive. Reactivate it before recording movements.</p> }
    </section>
}
else if (Model.ErrorMessage is null) { <p class="text-muted">All ingredient movements. Choose Stock / History on an ingredient to record a transaction.</p> }
@if (Model.Ledger is { } ledger)
{
    <section class="portal-card inventory-ledger"><div class="inventory-section-heading"><h2 class="h4">Immutable history</h2><span class="inventory-status is-muted">Read-only history</span></div><p>@ledger.TotalCount movements. Times in Asia/Bangkok (UTC+07:00).</p>
        <div class="table-responsive" tabindex="0" role="region" aria-label="Stock movement history"><table class="table inventory-table align-middle"><thead><tr><th scope="col">Reference / time</th><th scope="col">Ingredient</th><th scope="col">Type</th><th scope="col">Change</th><th scope="col">Before / after</th><th scope="col">Reason</th><th scope="col">Performed by</th></tr></thead><tbody>
            @foreach (var movement in ledger.Items) { <tr><td>#@movement.Id<br /><small>@ReportDisplay.Local(movement.CreatedAtUtc)</small><br /><small>@movement.RequestId</small></td><td>@movement.IngredientName</td><td>@movement.Type</td><td>@(movement.QuantityChange > 0 ? "+" : "")@movement.QuantityChange @movement.Unit</td><td>@movement.BalanceBefore / @movement.BalanceAfter @movement.Unit</td><td>@movement.Reason</td><td>@movement.PerformedByName</td></tr> }
            @if (ledger.Items.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-4">No stock movements recorded.</td></tr> }
        </tbody></table></div>
        <nav class="d-flex align-items-center gap-3" aria-label="Movement pages">
            @if (Model.PageNumber > 1) { <a asp-page="./Movements" asp-route-IngredientId="@Model.IngredientId" asp-route-PageNumber="@(Model.PageNumber - 1)" class="btn btn-outline-primary">Previous</a> }
            <span>Page @Model.PageNumber of @Model.TotalPages</span>
            @if (Model.PageNumber < Model.TotalPages) { <a asp-page="./Movements" asp-route-IngredientId="@Model.IngredientId" asp-route-PageNumber="@(Model.PageNumber + 1)" class="btn btn-outline-primary">Next</a> }
        </nav>
    </section>
}
</div>
@section Scripts { <script src="~/js/inventory.js" asp-append-version="true"></script> }
